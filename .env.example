# Required only for AI-assisted diagnosis when the local model is uncertain.
OPENAI_API_KEY=

# Model and inference settings
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
LOCAL_CONFIDENCE_THRESHOLD=0.75
LEAF_VALIDATOR_MODEL=ViT-B-32-quickgelu
LEAF_VALIDATOR_WEIGHTS=openai
LEAF_VALIDATOR_THRESHOLD=0.60

# Flask settings
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_HOST=127.0.0.1
FLASK_PORT=5100
FLASK_DEBUG=false
LOG_LEVEL=INFO

# MySQL account and Plant AI database. URL-encode reserved password characters.
DATABASE_URL=mariadb+mariadbconnector://root:password@127.0.0.1:3306/plant
DATABASE_FALLBACK_URL=sqlite:///plant_ai.db
ALLOW_DATABASE_FALLBACK=false

# Used once to create the first administrator when the user table is empty.
ADMIN_NAME=Plant AI Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Flutterwave Standard checkout. Use test keys during development.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_CURRENCY=USD
# Set to the public HTTPS application URL in production for callbacks/webhooks.
APP_BASE_URL=http://127.0.0.1:5001
